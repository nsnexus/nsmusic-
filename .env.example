# Gemini API configuration for composing lyrics (supports comma-separated keys for auto-failover rotation)
GEMINI_API_KEYS=your_first_gemini_key_here,your_second_gemini_key_here

# PagBank API configuration for processing PIX payments
PAGBANK_TOKEN=your_pagbank_bearer_token_here
PAGBANK_ENV=production

# Mercado Pago API configuration (legacy/fallback)
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token_here

# Segredo do webhook do Mercado Pago (painel MP > Webhooks > Chave secreta), usado para validar o
# header x-signature. Se ausente, a validação de assinatura é pulada (ver A-01 no AUDIT_REPORT.md) —
# configure assim que o webhook estiver registrado no painel do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=your_mercado_pago_webhook_secret_here

# NextJS Site URL (used for webhooks and payment redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Client Configuration keys
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# E-mails autorizados a usar as rotas administrativas (separados por vírgula).
# Mecanismo interino até um custom claim (admin: true) no Firebase Auth substituir esta allowlist.
ADMIN_EMAILS=admin@example.com

# Segredo compartilhado incluído na URL de callback registrada na Kie.ai (?secret=...), usado por
# /api/suno/webhook para autenticar a notificação (ver A-03 no AUDIT_REPORT.md). Se ausente, a
# checagem é pulada com aviso — gere um valor aleatório e configure antes de confiar no webhook.
KIE_WEBHOOK_SECRET=your_kie_webhook_secret_here

# Número de WhatsApp do admin (formato internacional com DDI, ex: 55DDXXXXXXXXX) que recebe a
# notificação de "nova venda" a cada pagamento aprovado. Antes hardcoded no código-fonte (ver B-06 no
# AUDIT_REPORT.md — o valor real foi removido do código, não reproduzido aqui). Se ausente, a
# notificação ao admin é simplesmente pulada (não afeta a aprovação nem o aviso ao cliente).
ADMIN_WHATSAPP=your_admin_whatsapp_number_here
