# M-23 no docs/audit/AUDIT_REPORT.md: este arquivo precisa listar toda variável de ambiente
# realmente lida pelo código (nem mais, nem menos) — conferido em 2026-08 contra `process.env.*`
# e `getRequestContext().env.*` em todo o src/.

# Kie.ai (Suno) — geração de música.
KIE_API_KEY=your_kie_api_key_here
# Segredo compartilhado incluído na URL de callback registrada na Kie.ai (?secret=...), usado por
# /api/suno/webhook para autenticar a notificação (ver A-03 no AUDIT_REPORT.md). Se ausente, a
# checagem é pulada com aviso — gere um valor aleatório e configure antes de confiar no webhook.
KIE_WEBHOOK_SECRET=your_kie_webhook_secret_here

# OpenAI (ChatGPT) — motor primário de composição da letra.
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini — motor de fallback da letra (aceita várias chaves separadas por vírgula, para
# rotação automática em caso de limite de uso).
GEMINI_API_KEYS=your_first_gemini_key_here,your_second_gemini_key_here

# Efí (ex-Gerencianet) — API Pix real (cobrança + webhook). Ver docs/EFI_SETUP.md para o passo a
# passo completo. A API Pix exige mTLS (certificado cliente) em toda chamada, e Cloudflare Pages não
# suporta esse tipo de binding (só Workers suportam) — por isso as duas variáveis EFI_PROXY_* abaixo:
# o app fala com um Worker dedicado (workers/efi-proxy/) que detém o certificado e repassa a chamada.
EFI_CLIENT_ID=your_efi_client_id_here
EFI_CLIENT_SECRET=your_efi_client_secret_here
# Chave Pix cadastrada na conta Efí usada para gerar as cobranças.
EFI_PIX_KEY=your_efi_pix_key_here
# sandbox (homologação) ou production. Comece por sandbox e só troque depois de validar o fluxo
# completo (criar → webhook → /entrega) com o Worker de mTLS deployado (ver docs/EFI_SETUP.md).
EFI_ENV=sandbox
# URL pública do Worker dedicado ao mTLS da Efí (workers/efi-proxy/), ex:
# https://nsmusic-efi-proxy.SEU_SUBDOMINIO.workers.dev — obtida depois de `npm run deploy:efi-proxy`.
EFI_PROXY_URL=your_efi_proxy_worker_url_here
# Segredo compartilhado entre este app e o Worker de mTLS (header X-Efi-Proxy-Secret). Gerar com
# `openssl rand -hex 32` e configurar com o MESMO valor em ambos: aqui e via
# `wrangler secret put EFI_PROXY_SECRET --config workers/efi-proxy/wrangler.toml`.
EFI_PROXY_SECRET=your_efi_proxy_secret_here
# Segredo incluído na URL do webhook registrado na Efí (?secret=...), usado por /api/webhooks/efi
# para uma primeira barreira antes de reconsultar a cobrança na API da Efí. Se ausente, a checagem é
# pulada com aviso — gere um valor aleatório e configure antes de confiar no webhook.
EFI_WEBHOOK_SECRET=your_efi_webhook_secret_here

# WhatsApp Business Platform (API Oficial da Meta / Cloud API) — único envio automático de WhatsApp
# do projeto: a mensagem de "música pronta" (ver src/lib/whatsapp.js:sendMusicReadyTemplate).
# Provedor não oficial (W-API) removido do projeto após sucessivos bloqueios de conta. Exige um
# Template pré-aprovado pela Meta chamado "nsmusic_musica_pronta" (categoria Utility) — sem ele
# aprovado, o envio falha mesmo com as variáveis configuradas corretamente.
# ID do número de telefone, obtido no WhatsApp Manager (Números > número verificado).
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# Token permanente gerado via um System User em Business Settings (escopo whatsapp_business_messaging).
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token_here
# Token que VOCÊ escolhe (ex: `openssl rand -hex 20`) e cola em dois lugares: aqui e no campo
# "Verificar token" da configuração de webhook no App Dashboard da Meta (WhatsApp > Configuração).
# Usado só pelo handshake de verificação em src/app/api/whatsapp/webhook/route.js — não envia nem
# recebe mensagem nenhuma, é só a Meta confirmando que a URL de callback é sua mesmo.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here

# Segredo compartilhado que autoriza /api/orders/reconcile a rodar sem conta de usuário (header
# X-Reconcile-Secret) — é o que permite um cron/agendador chamar a reconciliação de pedidos travados.
# Gerar com `openssl rand -hex 32`. Sem esta variável, a rota só aceita token de admin.
RECONCILE_SECRET=your_reconcile_secret_here

# Segredo do header Authorization (Bearer) de /api/cron/recover, chamado pelo agendador externo
# cron-job.org a cada 1h para a régua de recuperação de carrinho via WhatsApp. Gerar com
# `openssl rand -hex 24`. Sem esta variável, a rota falha com 500 (nunca aceita um valor fixo).
CRON_SECRET=your_cron_secret_here

# Meta Conversions API — envia o evento de Purchase direto do servidor (src/lib/metaCapi.js),
# chamado pelo único ponto de aprovação de pagamento (src/lib/payments.js:applyPaymentApproval).
# Substituiu o Purchase disparado no navegador (que usava localStorage para não contar a mesma
# venda duas vezes — quebrava toda vez que o cliente reabria o link de entrega em outro navegador,
# ex: o embutido do WhatsApp, contando a mesma venda de novo). Gerar em Meta Business Manager >
# Events Manager > Pixel > Configurações > Conversions API > Gerar token de acesso. Sem esta
# variável, o evento simplesmente não é enviado (aviso no log, nunca falha a aprovação do pagamento).
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token_here

# E-mails autorizados a usar as rotas administrativas (separados por vírgula).
# Mecanismo interino até um custom claim (admin: true) no Firebase Auth substituir esta allowlist.
ADMIN_EMAILS=admin@example.com

# URL pública do site (usada para montar links de webhook e de entrega).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuração pública do Firebase (client SDK) — não são segredos, mas precisam bater com o
# projeto real do Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
