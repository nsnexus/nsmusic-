# Configurações do Servidor
PORT=3100
NODE_ENV=production

# Token secreto de autenticação entre o Next.js e esta VPS
# O Next.js enviará: Authorization: Bearer <VPS_VIDEO_SECRET>
VPS_VIDEO_SECRET=gere_uma_chave_secreta_forte_aqui

# Concorrência máxima de vídeos sendo renderizados ao mesmo tempo
MAX_CONCURRENT_JOBS=2

# Supabase (para atualizar status, progresso e URL do pedido)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_do_supabase

# Cloudflare R2 (para fazer upload do vídeo MP4 gerado)
R2_ACCOUNT_ID=seu_cloudflare_account_id
R2_ACCESS_KEY_ID=seu_r2_access_key_id
R2_SECRET_ACCESS_KEY=seu_r2_secret_access_key
R2_BUCKET_NAME=nsmusic-media
R2_PUBLIC_URL=https://media.nsmusic.ia.br

# Notificação WhatsApp (opcional - W-API ou Evolution)
WHATSAPP_NOTIFICATION_ENABLED=false
